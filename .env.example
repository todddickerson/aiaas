# Supabase — project URL + anon key
# Day 1 plumbing only; real values come on Day 1.5 once the Supabase project is provisioned.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the brief validator (Slice A).
# Leave unset (or set ANTHROPIC_VALIDATOR_STUB=true) to use the deterministic
# stub validator. The stub is the default for local dev + CI so we don't
# burn tokens on every Playwright run.
ANTHROPIC_API_KEY=
ANTHROPIC_VALIDATOR_STUB=

# Whop API key for wallet holds + top-ups (Slice B).
# Leave unset (or set WHOP_STUB=true) to use the deterministic stub client.
# The stub returns idempotent stub_* IDs so the ledger + RLS can be tested
# end-to-end before the new biz_aiaas_* parent biz is provisioned.
WHOP_API_KEY=
WHOP_STUB=
