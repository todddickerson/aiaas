# Supabase — project URL + anon key
# Day 1 plumbing only; real values come on Day 1.5 once the Supabase project is provisioned.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the brief validator (Slice A).
# Leave unset (or set ANTHROPIC_VALIDATOR_STUB=true) to use the deterministic
# stub validator. The stub is the default for local dev + CI so we don't
# burn tokens on every Playwright run.
ANTHROPIC_API_KEY=
ANTHROPIC_VALIDATOR_STUB=

# Whop REST v1 — points at the AIaaS parent biz (`biz_9fbStuuVdEBhN9`).
# Default behavior: when WHOP_API_KEY is set we hit the real API; leave it
# unset (or set WHOP_STUB=true) for the deterministic stub client. The
# wallet ledger always works either way — only the network calls differ.
WHOP_API_KEY=
WHOP_BIZ_ID=biz_9fbStuuVdEBhN9
WHOP_API_BASE_URL=https://api.whop.com/api
WHOP_API_VERSION=v1
WHOP_STUB=

# Composio v3 API key for the integration proxy (Slice 2).
# Leave unset (or set COMPOSIO_STUB=true) to use the deterministic stub
# adapter. Stub mode returns plausible-looking payloads for Slack / Gmail /
# Notion and echo-only for everything else, so agent runs can exercise the
# proxy + audit pipeline without touching real third-party APIs.
COMPOSIO_API_KEY=
COMPOSIO_STUB=
